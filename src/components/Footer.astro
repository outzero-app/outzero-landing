---
import type { Locale } from "../i18n/translations";
import { localeHomePath, t } from "../i18n/translations";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);
const homePath = localeHomePath(locale);
const prefix = locale === "es" ? "/es" : "";

const links = [
  { href: "https://web.outzero.app", label: strings.footer_open_app },
  { href: `${prefix}/privacy-policy`, label: strings.footer_privacy },
  { href: `${prefix}/cookies-policy`, label: strings.footer_cookies },
  { href: `${prefix}/terms-of-use`, label: strings.footer_terms },
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <a href={homePath} aria-label="Outzero" class="footer-logo-link">
      <img src="/images/outzero_logo_white.svg" alt="Outzero" class="footer-logo" width="2702" height="417" />
    </a>

    <div class="footer-links">
      {links.map((link) => (
        <a href={link.href} class="footer-link">{link.label}</a>
      ))}
    </div>

    <span class="footer-copy">{strings.footer_copyright}</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 44px 0;
    background: var(--background);
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding-inline: clamp(20px, 5vw, 48px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .footer-logo-link {
    display: inline-flex;
  }

  .footer-logo {
    height: 18px;
    width: auto;
    display: block;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
  }

  .footer-link {
    font-size: 13px;
    font-weight: 300;
    line-height: 1;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--duration-base) ease;
  }

  .footer-link:hover {
    color: var(--text-primary);
  }

  .footer-copy {
    font-size: 13px;
    font-weight: 300;
    line-height: 1;
    color: var(--text-secondary);
  }

  :global([data-theme="light"]) .footer-logo {
    filter: brightness(0);
  }

  @media (max-width: 720px) {
    .footer-inner {
      justify-content: flex-start;
    }
  }
</style>
