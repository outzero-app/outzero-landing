---
/**
 * "Todo en una app" — six feature cards, with the Outzero+ card carrying a
 * green-tinted gradient and a badge.
 */
import type { Locale } from "../i18n/translations";
import { t } from "../i18n/translations";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);

const features = [
  { icon: "ui/satellite", title: strings.feature_map_title, desc: strings.feature_map_desc },
  { icon: "navigation/route", title: strings.feature_routes_title, desc: strings.feature_routes_desc },
  { icon: "navigation/eye", title: strings.feature_media_title, desc: strings.feature_media_desc },
  { icon: "spots/adventure", title: strings.feature_community_title, desc: strings.feature_community_desc },
  { icon: "navigation/explore", title: strings.feature_multiplatform_title, desc: strings.feature_multiplatform_desc },
];
---

<section id="features" class="features-section" aria-labelledby="features-title">
  <div class="oz-container">
    <div class="section-intro section-intro--center">
      <p class="section-kicker section-kicker--both">{strings.features_label}</p>
      <h2 id="features-title" class="section-title max-w-[16ch]">{strings.features_title}</h2>
      <p class="section-copy max-w-[600px]">{strings.features_subtitle}</p>
    </div>

    <div class="features-grid">
      {features.map((feature) => (
        <article class="feature-card">
          <div class="feature-head">
            <span
              class="oz-icon-mask oz-icon-mask--green feature-icon"
              style={`--icon-url: url("/icons/${feature.icon}.svg");`}
              aria-hidden="true"
            ></span>
            <h3 class="feature-title">{feature.title}</h3>
          </div>
          <p class="feature-desc">{feature.desc}</p>
        </article>
      ))}

      <article class="feature-card feature-card--plus">
        <div class="feature-head">
          <span class="plus-badge">{strings.feature_plus_title}</span>
        </div>
        <p class="feature-desc" set:html={strings.feature_plus_desc_html}></p>
      </article>
    </div>
  </div>
</section>

<style>
  .features-section {
    padding-block: clamp(72px, 10vw, 120px);
    background: var(--splash);
    border-block: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
    scroll-margin-top: 80px;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    margin-top: 52px;
  }

  .feature-card {
    background: var(--background);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 28px;
  }

  .feature-card--plus {
    background: linear-gradient(
      150deg,
      color-mix(in srgb, var(--color-brand-green) 14%, var(--background)),
      var(--background) 70%
    );
    border-color: color-mix(in srgb, var(--color-brand-green) 35%, var(--border-subtle));
  }

  .feature-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }

  .feature-icon {
    width: 26px;
    height: 26px;
    flex: none;
  }

  .feature-title {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
    /* 1.1 in the design, loosened slightly so two-line titles don't collide. */
    line-height: 1.2;
    letter-spacing: -0.4px;
    color: var(--text-primary);
  }

  .plus-badge {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    background: var(--tag-green);
    color: var(--tag-green-fg);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .feature-desc {
    margin: 0;
    font-size: 15px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .feature-desc :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }
</style>
