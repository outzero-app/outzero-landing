---
/**
 * "Nuestra historia" — narrative copy alongside a real spot photo.
 */
import type { Locale } from "../i18n/translations";
import { t } from "../i18n/translations";
import { fetchLandingSpots } from "../lib/spots";
import PhotoCredit from "./PhotoCredit.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);
const landing = await fetchLandingSpots(locale);
const photo = landing.showcase.story;
const storyPool = landing.rotation.story;
---

<section id="about" class="story-section" data-story-root aria-labelledby="about-title">
  <div class="oz-story-grid">
    <div>
      <p class="section-kicker">{strings.about_label}</p>

      <h2 id="about-title" class="story-headline" set:html={strings.about_headline_html}></h2>

      <p class="story-copy">{strings.about_paragraph_1}</p>

      <p class="story-copy" set:html={strings.about_paragraph_2_html}></p>
    </div>

    {photo && (
      <div class="story-photo-wrap">
        <img src={photo.url} alt="" class="story-photo" data-story-photo loading="lazy" />
        <PhotoCredit image={photo} locale={locale} placement="bottom-left" />
      </div>
    )}
  </div>
</section>

<script type="application/json" data-story-rotation set:html={JSON.stringify(storyPool)}></script>

<script>
  interface RotationPhoto {
    id: string;
    name: string;
    url: string;
    author?: string;
  }

  function randomItem<T>(items: T[]): T | null {
    if (items.length === 0) {
      return null;
    }
    return items[Math.floor(Math.random() * items.length)] ?? null;
  }

  const root = document.querySelector<HTMLElement>("[data-story-root]");
  const rotationNode = document.querySelector<HTMLScriptElement>("[data-story-rotation]");
  const pool = rotationNode?.textContent ? JSON.parse(rotationNode.textContent) as RotationPhoto[] : [];
  const picked = randomItem(pool);

  if (root && picked) {
    root.querySelector<HTMLImageElement>("[data-story-photo]")?.setAttribute("src", picked.url);

    const credit = root.querySelector<HTMLAnchorElement>(".photo-credit");
    if (credit) {
      credit.href = `https://web.outzero.app/spot/${picked.id}`;
      credit.querySelector<HTMLElement>(".photo-credit-name")?.replaceChildren(picked.name);

      const existingAuthor = credit.querySelector<HTMLElement>(".photo-credit-author");
      if (picked.author) {
        if (existingAuthor) {
          existingAuthor.replaceChildren(picked.author);
        } else {
          const author = document.createElement("span");
          author.className = "photo-credit-author";
          author.textContent = picked.author;
          credit.appendChild(author);
        }
      } else if (existingAuthor) {
        existingAuthor.remove();
      }
    }
  }
</script>

<style>
  .story-section {
    padding-block: var(--section-padding);
    background: var(--splash);
    border-block: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
  }

  .oz-story-grid {
    display: grid;
    gap: 48px;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding-inline: clamp(20px, 5vw, 48px);
  }

  @media (max-width: 880px) {
    .oz-story-grid {
      grid-template-columns: 1fr;
    }
  }

  .story-headline {
    margin: 16px 0 0;
    font-size: clamp(20px, 2.4vw, 30px);
    font-weight: 300;
    line-height: 1.5;
    letter-spacing: -0.4px;
    color: var(--text-primary);
  }

  .story-headline :global(em) {
    font-style: normal;
    font-weight: 600;
    color: var(--tag-green);
  }

  .story-copy {
    margin: 22px 0 0;
    font-size: clamp(14px, 1.3vw, 17px);
    font-weight: 300;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .story-copy + .story-copy {
    margin-top: 14px;
  }

  .story-copy :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .story-photo-wrap {
    position: relative;
    display: flex;
  }

  .story-photo {
    width: 100%;
    max-height: 440px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-2xl);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-card);
  }
</style>
