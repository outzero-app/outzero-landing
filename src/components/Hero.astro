---
/**
 * Photo-led hero: a real verified spot photo behind the headline, with the two
 * primary CTAs, the store badges and the proof chips.
 */
import type { Locale } from "../i18n/translations";
import { t } from "../i18n/translations";
import { fetchLandingSpots } from "../lib/spots";
import PhotoCredit from "./PhotoCredit.astro";

interface Props {
  locale: Locale;
  showBadges?: boolean;
}

const { locale, showBadges = true } = Astro.props;
const strings = t(locale);


const appStoreUrl = "https://apps.apple.com/us/app/outzero/id6760965247";
const googlePlayUrl = "https://play.google.com/store/apps/details?id=com.outzero.app";
const exploreUrl = "https://web.outzero.app/explore";

// A real mirador/summit shot rather than stock photography.
const landing = await fetchLandingSpots(locale);
const backdrop = landing.showcase.hero;
const heroPool = landing.rotation.hero;
const heroPoolForClient =
  heroPool.length > 0
    ? heroPool
    : backdrop
      ? [
          {
            id: backdrop.spotId,
            name: backdrop.name,
            url: backdrop.url,
            author: backdrop.authorHandle,
          },
        ]
      : [];

const proofs = [
  strings.hero_proof_exact_locations,
  strings.hero_proof_real_videos,
  strings.hero_proof_visual_routes,
  strings.hero_proof_platforms,
];
---

<header id="hero" class="hero" data-hero-root>
  {backdrop && (
    <>
      {/* No `src` in the markup on purpose. The backdrop is drawn from the
          rotation pool by the inline script below, and a server-rendered src
          would make the browser download a photo it is about to replace —
          expensive for what is the page's LCP element. */}
      <img alt="" class="hero-photo" data-hero-photo fetchpriority="high" />
      <noscript>
        <img src={backdrop.url} alt="" class="hero-photo" fetchpriority="high" />
      </noscript>
    </>
  )}
  <div class="hero-tint" aria-hidden="true"></div>
  <div class="hero-fade" aria-hidden="true"></div>

  <div class="hero-inner">
    <div class="hero-content">
      <div class="hero-eyebrow">
        <span class="hero-rule" aria-hidden="true"></span>
        <span>{strings.hero_eyebrow}</span>
      </div>

      <h1 class="hero-title">
        {strings.hero_headline_1}{" "}
        <span class="hero-title-accent">{strings.hero_headline_2}</span>
      </h1>

      <p class="hero-sub">{strings.hero_subheadline}</p>

      <div class="hero-actions">
        <a href={exploreUrl} class="btn btn-primary btn-lg">{strings.hero_cta}</a>
        <a href="#features" class="btn btn-outline btn-lg">{strings.hero_learn_more}</a>
      </div>

      {showBadges && (
        <div class="hero-badges">
          <a href={appStoreUrl} aria-label={strings.hero_download_ios}>
            <img src="/images/app_store_badge.png" alt={strings.hero_download_ios} class="store-badge" />
          </a>
          <a href={googlePlayUrl} aria-label={strings.hero_download_android}>
            <img src="/images/google_play_badge.png" alt={strings.hero_download_android} class="store-badge" />
          </a>
        </div>
      )}

      <p class="hero-hint">{strings.hero_web_hint}</p>

      <div class="hero-proofs">
        {proofs.map((proof) => (
          <span class="hero-proof">
            <span class="hero-dot" aria-hidden="true"></span>
            {proof}
          </span>
        ))}
      </div>
    </div>
  </div>

  {backdrop && <PhotoCredit image={backdrop} locale={locale} />}
</header>

{/*
  Inline and synchronous, immediately after the markup it touches: a bundled
  module script would only run once the whole document had been parsed, and the
  hero photo cannot start downloading until it has a src. Everything it needs is
  in `define:vars`, so it makes no requests of its own.
*/}
<script is:inline define:vars={{ heroPool: heroPoolForClient }}>
  const picked =
    heroPool.length > 0 ? heroPool[Math.floor(Math.random() * heroPool.length)] : null;
  const heroRoot = document.querySelector("[data-hero-root]");

  if (heroRoot && picked) {
    const photo = heroRoot.querySelector("[data-hero-photo]");
    if (photo) {
      photo.src = picked.url;
    }

    const credit = heroRoot.querySelector(".photo-credit");
    if (credit) {
      credit.href = "https://web.outzero.app/spot/" + picked.id;

      const name = credit.querySelector(".photo-credit-name");
      if (name) {
        name.textContent = picked.name;
      }

      const author = credit.querySelector(".photo-credit-author");
      if (author) {
        author.textContent = picked.author || "";
        author.hidden = !picked.author;
      }
    }
  }
</script>

<style>
  /* Exactly one screen tall: the hero is the section that must always be
     readable without scrolling, so its content is sized to fit rather than
     allowed to push the section taller. */
  .hero {
    position: relative;
    min-height: 100svh;
    max-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-tint {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.64) 46%, rgba(0, 0, 0, 0.3) 100%);
  }

  .hero-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.4) 0%,
      transparent 22%,
      transparent 55%,
      var(--background) 100%
    );
  }

  /* The design's green glow orb is deliberately not used: the backdrop is a
     different real photo on every build, and the tint clashed with some of
     them. The gradients above already carry the brand feel. */

  .hero-inner {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    /* Clears the fixed navbar and then some, so the eyebrow never crowds it. */
    padding-block: calc(var(--navbar-height) + clamp(28px, 5.5vh, 60px))
      clamp(44px, 7vh, 78px);
    padding-inline: clamp(20px, 5vw, 48px);
  }

  .hero-content {
    max-width: 760px;
    animation: ozUp 0.7s var(--ease-out) both;
  }

  @keyframes ozUp {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 22px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2.4px;
    text-transform: uppercase;
    color: var(--tag-green);
  }

  .hero-rule {
    width: 42px;
    height: 1px;
    background: var(--tag-green);
    opacity: 0.8;
  }

  /* Sized by whichever runs out first, width or height, so the hero keeps its
     breathing room on short screens instead of pressing against the edges. */
  .hero-title {
    margin: 0;
    font-size: clamp(38px, min(7.2vw, 8.6vh), 86px);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--color-primary-white);
    text-wrap: balance;
  }

  .hero-title-accent {
    color: var(--color-brand-green);
  }

  .hero-sub {
    margin: 26px 0 0;
    max-width: 560px;
    font-size: clamp(16px, 1.6vw, 20px);
    font-weight: 300;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.86);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 36px;
    align-items: center;
  }

  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-top: 22px;
  }

  .store-badge {
    height: 50px;
    display: block;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .store-badge:hover {
    transform: translateY(-2px);
  }

  .hero-hint {
    margin: 22px 0 0;
    font-size: 14px;
    font-weight: 300;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.62);
  }

  .hero-proofs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin-top: 26px;
  }

  .hero-proof {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-primary-white);
  }

  .hero-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-brand-green);
  }

  @media (max-width: 640px) {
    .store-badge {
      height: 42px;
    }

    /* The proof chips wrap onto two lines here and run into the photo credit
       pinned bottom-right. They're a nice-to-have and the same claims appear
       again further down the page, so they give way. */
    .hero-proofs {
      display: none;
    }
  }

  /* On the narrowest phones the hint line reaches the credit too. */
  @media (max-width: 400px) {
    .hero-hint {
      display: none;
    }
  }

  /* Short viewports (most phones in landscape, small laptops): tighten the
     vertical rhythm so the whole hero still fits on one screen. */
  /* The title clamp already scales with height; these only tighten the gaps. */
  @media (max-height: 760px) {
    .hero-eyebrow {
      margin-bottom: 14px;
    }

    .hero-sub {
      margin-top: 16px;
      font-size: clamp(14px, 1.4vw, 17px);
      line-height: 1.5;
    }

    .hero-actions {
      margin-top: 22px;
    }

    .hero-badges {
      margin-top: 14px;
    }

    .store-badge {
      height: 40px;
    }

    .hero-hint {
      margin-top: 14px;
    }

    .hero-proofs {
      margin-top: 16px;
      gap: 8px 18px;
    }
  }

  @media (max-height: 620px) {
    .hero-hint,
    .hero-proofs {
      display: none;
    }

    .store-badge {
      height: 34px;
    }
  }
</style>
