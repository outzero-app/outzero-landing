---
/**
 * Photo-led hero: a real verified spot photo behind the headline, with the two
 * primary CTAs, the store badges and the proof chips.
 */
import type { Locale } from "../i18n/translations";
import { t } from "../i18n/translations";
import { fetchLandingSpots } from "../lib/spots";

interface Props {
  locale: Locale;
  glow?: boolean;
  showBadges?: boolean;
}

const { locale, glow = true, showBadges = true } = Astro.props;
const strings = t(locale);

const appStoreUrl = "https://apps.apple.com/us/app/outzero/id6760965247";
const googlePlayUrl = "https://play.google.com/store/apps/details?id=com.outzero.app";
const exploreUrl = "https://web.outzero.app/explore";

// A real mirador/summit shot rather than stock photography.
const backdrop = (await fetchLandingSpots(locale)).showcase.hero;

const proofs = [
  strings.hero_proof_exact_locations,
  strings.hero_proof_real_videos,
  strings.hero_proof_visual_routes,
  strings.hero_proof_platforms,
];
---

<header id="hero" class="hero">
  {backdrop && <img src={backdrop} alt="" class="hero-photo" fetchpriority="high" />}
  <div class="hero-tint" aria-hidden="true"></div>
  <div class="hero-fade" aria-hidden="true"></div>
  {glow && <div class="hero-glow" aria-hidden="true"></div>}

  <div class="hero-inner">
    <div class="hero-content">
      <div class="hero-eyebrow">
        <span class="hero-rule" aria-hidden="true"></span>
        <span>{strings.hero_eyebrow}</span>
      </div>

      <h1 class="hero-title">
        {strings.hero_headline_1}{" "}
        <span class="hero-title-accent">{strings.hero_headline_2}</span>
      </h1>

      <p class="hero-sub">{strings.hero_subheadline}</p>

      <div class="hero-actions">
        <a href={exploreUrl} class="btn btn-primary btn-lg">{strings.hero_cta}</a>
        <a href="#features" class="btn btn-outline btn-lg">{strings.hero_learn_more}</a>
      </div>

      {showBadges && (
        <div class="hero-badges">
          <a href={appStoreUrl} aria-label={strings.hero_download_ios}>
            <img src="/images/app_store_badge.png" alt={strings.hero_download_ios} class="store-badge" />
          </a>
          <a href={googlePlayUrl} aria-label={strings.hero_download_android}>
            <img src="/images/google_play_badge.png" alt={strings.hero_download_android} class="store-badge" />
          </a>
        </div>
      )}

      <p class="hero-hint">{strings.hero_web_hint}</p>

      <div class="hero-proofs">
        {proofs.map((proof) => (
          <span class="hero-proof">
            <span class="hero-dot" aria-hidden="true"></span>
            {proof}
          </span>
        ))}
      </div>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-tint {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.64) 46%, rgba(0, 0, 0, 0.3) 100%);
  }

  .hero-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.4) 0%,
      transparent 22%,
      transparent 55%,
      var(--background) 100%
    );
  }

  .hero-glow {
    position: absolute;
    bottom: -140px;
    left: -80px;
    width: 520px;
    height: 520px;
    border-radius: 50%;
    background: var(--color-brand-green);
    filter: blur(150px);
    opacity: 0.16;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 120px clamp(20px, 5vw, 48px) 80px;
  }

  .hero-content {
    max-width: 760px;
    animation: ozUp 0.7s var(--ease-out) both;
  }

  @keyframes ozUp {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 22px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2.4px;
    text-transform: uppercase;
    color: var(--tag-green);
  }

  .hero-rule {
    width: 42px;
    height: 1px;
    background: var(--tag-green);
    opacity: 0.8;
  }

  .hero-title {
    margin: 0;
    font-size: clamp(44px, 7.2vw, 86px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -2.5px;
    color: var(--color-primary-white);
    text-wrap: balance;
  }

  .hero-title-accent {
    color: var(--color-brand-green);
  }

  .hero-sub {
    margin: 26px 0 0;
    max-width: 560px;
    font-size: clamp(16px, 1.6vw, 20px);
    font-weight: 300;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.86);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 36px;
    align-items: center;
  }

  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-top: 22px;
  }

  .store-badge {
    height: 50px;
    display: block;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .store-badge:hover {
    transform: translateY(-2px);
  }

  .hero-hint {
    margin: 22px 0 0;
    font-size: 14px;
    font-weight: 300;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.62);
  }

  .hero-proofs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin-top: 26px;
  }

  .hero-proof {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-primary-white);
  }

  .hero-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-brand-green);
  }

  @media (max-width: 640px) {
    .store-badge {
      height: 42px;
    }
  }
</style>
