---
import type { Locale } from "../i18n/translations";
import { t } from "../i18n/translations";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);
const appStoreUrl = "https://apps.apple.com/us/app/outzero/id6760965247";
const googlePlayUrl = "https://play.google.com/store/apps/details?id=com.outzero.app";
---

<section
  id="hero"
  class="relative flex min-h-[100svh] items-center justify-center overflow-hidden"
>
  <!-- Animated background gradient -->
  <div class="hero-bg absolute inset-0 -z-10" aria-hidden="true"></div>

  <!-- Floating green glow orbs -->
  <div class="hero-orb hero-orb--1 absolute -z-10" aria-hidden="true"></div>
  <div class="hero-orb hero-orb--2 absolute -z-10" aria-hidden="true"></div>
  <div class="hero-orb hero-orb--3 absolute -z-10" aria-hidden="true"></div>

  <!-- Content -->
  <div class="hero-content relative z-10 mx-auto flex w-full max-w-5xl flex-col items-center px-6 text-center lg:px-8">
    <!-- Logo icon -->
    <div class="mx-auto mb-8 flex justify-center">
      <img
        src="/images/outzero_icon_white.svg"
        alt=""
        class="hero-logo h-16 w-auto opacity-90 sm:h-20 hero-icon"
        aria-hidden="true"
      />
    </div>

    <!-- Headline -->
    <h1
      class="hero-title mx-auto max-w-4xl text-4xl font-semibold tracking-tight sm:text-5xl md:text-6xl lg:text-7xl"
      style="color: var(--text-primary); letter-spacing: -1px; line-height: 1.1;"
    >
      {strings.hero_headline_1}
      <span class="block text-[var(--tag-green)]">{strings.hero_headline_2}</span>
    </h1>

    <!-- Subheadline -->
    <p
      class="hero-subheadline mx-auto mt-6 max-w-2xl text-base font-light sm:text-lg md:text-xl"
      style="color: var(--text-secondary); line-height: 1.6;"
    >
      {strings.hero_subheadline}
    </p>

    <!-- CTA actions -->
    <div class="hero-actions mx-auto mt-10 flex w-full max-w-[40rem] flex-col items-center gap-4">
      <div class="hero-actions-row grid w-full grid-cols-1 gap-4 sm:grid-cols-2">
        <a
          href="https://web.outzero.app"
          class="hero-action-button group relative inline-flex w-full items-center justify-center gap-2 rounded-[var(--radius-brand)] bg-[var(--tag-green)] px-8 py-3.5 text-base font-semibold text-[var(--tag-green-fg)] transition-all hover:scale-105 active:scale-95 sm:text-lg"
        >
          {strings.hero_cta}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5 transition-transform group-hover:translate-x-1"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>

        <a
          href="#features"
          class="hero-action-button inline-flex w-full items-center justify-center gap-1.5 rounded-[var(--radius-brand)] border border-[var(--border)] px-6 py-3 text-sm font-semibold transition-colors hover:bg-[var(--surface)]"
          style="color: var(--text-primary);"
        >
          {strings.hero_learn_more}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
      </div>

      <div class="hero-actions-row grid w-full grid-cols-1 gap-4 sm:grid-cols-2">
        <a
          href={appStoreUrl}
          aria-label={strings.hero_download_ios}
          class="hero-action-button store-badge-link inline-flex w-full items-center justify-center rounded-[var(--radius-brand)] border border-[var(--border)] bg-[var(--background)] p-1 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--tag-green)] hover:bg-[var(--surface)]"
        >
          <img
            src="/images/app_store_badge.png"
            alt={strings.hero_download_ios}
            class="store-badge h-10 w-auto"
            loading="eager"
          />
        </a>

        <a
          href={googlePlayUrl}
          aria-label={strings.hero_download_android}
          class="hero-action-button store-badge-link inline-flex w-full items-center justify-center rounded-[var(--radius-brand)] border border-[var(--border)] bg-[var(--background)] p-1 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--tag-green)] hover:bg-[var(--surface)]"
        >
          <img
            src="/images/google_play_badge.png"
            alt={strings.hero_download_android}
            class="store-badge h-10 w-auto"
            loading="eager"
          />
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll hint -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce" aria-hidden="true">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-6 w-6 opacity-40"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="1.5"
      style="color: var(--text-secondary);"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </div>
</section>

<style>
  .hero-content {
    padding-top: clamp(6rem, 11vh, 8rem);
    padding-bottom: clamp(4rem, 8vh, 6rem);
  }

  .hero-bg {
    background: radial-gradient(
        ellipse 80% 60% at 50% 120%,
        rgba(205, 250, 177, 0.08) 0%,
        transparent 70%
      ),
      radial-gradient(
        ellipse 60% 50% at 80% 20%,
        rgba(115, 171, 191, 0.05) 0%,
        transparent 60%
      ),
      var(--background);
  }

  .hero-orb {
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.15;
  }

  .hero-orb--1 {
    width: 400px;
    height: 400px;
    background: var(--color-brand-green);
    top: 10%;
    left: -5%;
    animation: float-1 12s ease-in-out infinite;
  }

  .hero-orb--2 {
    width: 300px;
    height: 300px;
    background: var(--color-accent-blue);
    bottom: 10%;
    right: -5%;
    animation: float-2 15s ease-in-out infinite;
  }

  .hero-orb--3 {
    width: 200px;
    height: 200px;
    background: var(--color-brand-green);
    top: 50%;
    left: 60%;
    animation: float-3 10s ease-in-out infinite;
  }

  @keyframes float-1 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(40px, -30px); }
  }
  @keyframes float-2 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(-30px, 20px); }
  }
  @keyframes float-3 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(-20px, -40px); }
  }

  [data-theme="light"] .hero-bg {
    background: radial-gradient(
        ellipse 80% 60% at 50% 120%,
        rgba(43, 79, 10, 0.06) 0%,
        transparent 70%
      ),
      radial-gradient(
        ellipse 60% 50% at 80% 20%,
        rgba(115, 171, 191, 0.06) 0%,
        transparent 60%
      ),
      var(--background);
  }

  [data-theme="light"] .hero-icon {
    filter: brightness(0);
  }

  [data-theme="light"] .hero-orb {
    opacity: 0.08;
  }

  .store-badge-link {
    transition: transform 160ms ease, opacity 160ms ease;
  }

  .hero-action-button {
    min-height: 4rem;
  }

  .hero-actions-row {
    align-items: stretch;
  }

  .store-badge-link:hover {
    transform: translateY(-2px);
    opacity: 0.96;
  }

  .store-badge {
    display: block;
  }

  @media (max-height: 880px) {
    .hero-content {
      padding-top: 5.5rem;
      padding-bottom: 3rem;
    }

    .hero-logo {
      height: 3.5rem;
    }

    .hero-title {
      font-size: clamp(3rem, 7vw, 5rem);
    }

    .hero-subheadline {
      margin-top: 1rem;
      font-size: 1.05rem;
      line-height: 1.5;
    }

    .hero-actions {
      margin-top: 1.75rem;
      gap: 0.875rem;
    }

    .hero-action-button {
      min-height: 3.75rem;
    }

    .store-badge {
      height: 2.5rem;
    }
  }

  @media (max-height: 760px) {
    .hero-content {
      padding-top: 5rem;
      padding-bottom: 2.5rem;
    }

    .hero-title {
      font-size: clamp(2.5rem, 6vw, 4.25rem);
      line-height: 1.05;
    }

    .hero-subheadline {
      max-width: 46rem;
      font-size: 1rem;
      line-height: 1.45;
    }

    .hero-actions {
      margin-top: 1.5rem;
    }

    .hero-action-button {
      min-height: 3.5rem;
    }

    .store-badge {
      height: 2.25rem;
    }
  }
</style>
