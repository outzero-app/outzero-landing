---
/**
 * Closing CTA — a full-bleed photo panel over a real spot image.
 */
import type { Locale } from "../i18n/translations";
import { t } from "../i18n/translations";
import { fetchLandingSpots } from "../lib/spots";
import PhotoCredit from "./PhotoCredit.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);
const landing = await fetchLandingSpots(locale);
const photo = landing.showcase.cta;
const ctaPool = landing.rotation.cta;
---

<section class="page-section" data-cta-root aria-labelledby="cta-title">
  <div class="oz-container">
    <div class="cta-panel">
      {photo && <img src={photo.url} alt="" class="cta-photo" data-cta-photo loading="lazy" />}
      <div class="cta-overlay" aria-hidden="true"></div>
      {photo && <PhotoCredit image={photo} locale={locale} />}

      <div class="cta-content">
        <h2 id="cta-title" class="cta-title">{strings.cta_title}</h2>
        <p class="cta-sub">{strings.cta_subtitle}</p>
        <div class="cta-actions">
          <a href="https://web.outzero.app/explore" class="btn btn-primary btn-lg">{strings.cta_button}</a>
        </div>
        <p class="cta-helper">{strings.cta_helper}</p>
      </div>
    </div>
  </div>
</section>

<script type="application/json" data-cta-rotation set:html={JSON.stringify(ctaPool)}></script>

<script>
  interface RotationPhoto {
    id: string;
    name: string;
    url: string;
    author?: string;
  }

  function randomItem<T>(items: T[]): T | null {
    if (items.length === 0) {
      return null;
    }
    return items[Math.floor(Math.random() * items.length)] ?? null;
  }

  const root = document.querySelector<HTMLElement>("[data-cta-root]");
  const rotationNode = document.querySelector<HTMLScriptElement>("[data-cta-rotation]");
  const pool = rotationNode?.textContent ? JSON.parse(rotationNode.textContent) as RotationPhoto[] : [];
  const picked = randomItem(pool);

  if (root && picked) {
    root.querySelector<HTMLImageElement>("[data-cta-photo]")?.setAttribute("src", picked.url);

    const credit = root.querySelector<HTMLAnchorElement>(".photo-credit");
    if (credit) {
      credit.href = `https://web.outzero.app/spot/${picked.id}`;
      credit.querySelector<HTMLElement>(".photo-credit-name")?.replaceChildren(picked.name);

      const existingAuthor = credit.querySelector<HTMLElement>(".photo-credit-author");
      if (picked.author) {
        if (existingAuthor) {
          existingAuthor.replaceChildren(picked.author);
        } else {
          const author = document.createElement("span");
          author.className = "photo-credit-author";
          author.textContent = picked.author;
          credit.appendChild(author);
        }
      } else if (existingAuthor) {
        existingAuthor.remove();
      }
    }
  }
</script>

<style>
  .cta-panel {
    position: relative;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    padding: clamp(56px, 9vw, 104px) clamp(24px, 5vw, 48px);
    text-align: center;
  }

  .cta-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cta-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.72));
  }

  .cta-content {
    position: relative;
    z-index: 2;
  }

  .cta-title {
    margin: 0 auto;
    max-width: 16ch;
    font-size: clamp(30px, 5vw, 58px);
    font-weight: 600;
    line-height: 1.03;
    letter-spacing: -1.8px;
    color: var(--color-primary-white);
  }

  .cta-sub {
    margin: 20px auto 0;
    max-width: 560px;
    font-size: clamp(15px, 1.5vw, 19px);
    font-weight: 300;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
  }

  .cta-actions {
    margin-top: 32px;
    display: flex;
    justify-content: center;
  }

  .cta-helper {
    margin: 16px 0 0;
    font-size: 13px;
    font-weight: 300;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.6);
  }
</style>
