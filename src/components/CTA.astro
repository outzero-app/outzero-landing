---
import type { Locale } from "../i18n/translations";
import { t } from "../i18n/translations";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);
---

<section class="page-section" aria-labelledby="cta-title">
  <div class="mx-auto max-w-4xl px-6 text-center lg:px-8">
    <div class="section-intro section-intro--center">
      <p class="section-kicker">{strings.cta_label}</p>

      <h2 id="cta-title" class="section-title max-w-[14ch]">
        {strings.cta_title}
      </h2>
      <p class="section-copy max-w-2xl">
        {strings.cta_subtitle}
      </p>
    </div>

    <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href="https://web.outzero.app"
        class="group inline-flex items-center gap-2 rounded-[var(--radius-brand)] bg-[var(--tag-green)] px-8 py-3.5 text-base font-semibold text-[var(--tag-green-fg)] transition-all hover:scale-105 active:scale-95 sm:text-lg"
      >
        {strings.cta_button}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5 transition-transform group-hover:translate-x-1"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>

      <a
        href="#features"
        class="inline-flex items-center justify-center rounded-[var(--radius-brand)] border border-[var(--border)] px-6 py-3 text-sm font-semibold transition-colors hover:bg-[var(--surface)] sm:text-base"
        style="color: var(--text-primary);"
      >
        {strings.cta_secondary}
      </a>
    </div>

    <p
      class="mx-auto mt-4 max-w-lg text-xs font-light sm:text-sm"
      style="color: var(--text-secondary);"
    >
      {strings.cta_helper}
    </p>
  </div>
</section>
