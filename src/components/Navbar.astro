---
import type { Locale } from "../i18n/translations";
import { t, alternateLocale, localeHomePath } from "../i18n/translations";

interface Props {
  locale: Locale;
  alternatePath?: string;
}

const { locale, alternatePath } = Astro.props;
const strings = t(locale);
const altLocale = alternateLocale(locale);
const homePath = localeHomePath(locale);
// `?lang=` makes the choice survive the auto-redirect on `/`, which reads it
// before deciding anything (see Layout.astro).
const altPath = `${alternatePath ?? localeHomePath(altLocale)}?lang=${altLocale}`;
const sectionLinks = [
  { href: `${homePath}#spot-types`, label: strings.nav_spots },
  { href: `${homePath}#features`, label: strings.nav_features },
  { href: `${homePath}#about`, label: strings.nav_story },
];
---

<nav
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  aria-label="Primary"
>
  <div class="nav-inner">
    <div class="nav-left">
      <a href={homePath} class="nav-logo-link" aria-label="Outzero">
        <img src="/images/outzero_logo_white.svg" alt="Outzero" class="nav-logo" />
      </a>

      <div class="nav-links">
        {sectionLinks.map((link) => (
          <a href={link.href} class="nav-link">{link.label}</a>
        ))}
      </div>
    </div>

    <div class="nav-right">
      <!-- Language switcher: shows both locales, active one in brand green -->
      <a
        href={altPath}
        class="lang-switch"
        aria-label={`Switch to ${altLocale === "es" ? "Spanish" : "English"}`}
      >
        <span class={locale === "es" ? "lang-active" : "lang-idle"}>ES</span>
        <span class="lang-sep" aria-hidden="true">/</span>
        <span class={locale === "en" ? "lang-active" : "lang-idle"}>EN</span>
      </a>

      <a href="https://web.outzero.app" class="btn btn-primary btn-sm nav-cta">{strings.nav_open_app}</a>

      <button
        type="button"
        id="nav-toggle"
        class="nav-toggle"
        aria-controls="nav-mobile"
        aria-expanded="false"
        aria-label={strings.nav_menu}
      >
        <span class="nav-toggle-bar" aria-hidden="true"></span>
        <span class="nav-toggle-bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div id="nav-mobile" class="nav-mobile" hidden>
    {sectionLinks.map((link) => (
      <a href={link.href} class="nav-mobile-link">{link.label}</a>
    ))}
    <a href="https://web.outzero.app" class="btn btn-primary nav-mobile-cta">{strings.nav_open_app}</a>
    <a href={altPath} class="lang-switch lang-switch--mobile">
      <span class={locale === "es" ? "lang-active" : "lang-idle"}>ES</span>
      <span class="lang-sep" aria-hidden="true">/</span>
      <span class={locale === "en" ? "lang-active" : "lang-idle"}>EN</span>
    </a>
  </div>
</nav>

<script>
  // The language choice is persisted from the `?lang=` param in Layout.astro,
  // so this script only handles the scroll state and the mobile menu.
  const navbar = document.getElementById("navbar");
  const toggle = document.getElementById("nav-toggle");
  const mobileMenu = document.getElementById("nav-mobile");

  if (toggle && mobileMenu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      mobileMenu.hidden = !open;
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    // Following an in-page link should close the menu.
    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        setOpen(false);
      }
    });

    // Leaving the mobile breakpoint must not strand the menu open.
    const wide = window.matchMedia("(min-width: 881px)");
    wide.addEventListener("change", (event) => {
      if (event.matches) {
        setOpen(false);
      }
    });
  }

  if (navbar) {
    const syncNavbarState = () => {
      if (window.scrollY > 40) {
        navbar.classList.add("navbar-scrolled");
      } else {
        navbar.classList.remove("navbar-scrolled");
      }
    };

    syncNavbarState();
    window.addEventListener("scroll", syncNavbarState, { passive: true });
  }
</script>

<style>
  /* The bar is always semi-opaque with a blur, as in the design; scrolling
     only deepens it. */
  #navbar {
    background-color: color-mix(in srgb, var(--background) 68%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 55%, transparent);
  }

  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 16px clamp(20px, 5vw, 48px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .nav-left {
    display: flex;
    align-items: center;
    gap: 36px;
    min-width: 0;
  }

  .nav-logo-link {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .nav-logo {
    height: 22px;
    width: auto;
    display: block;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 26px;
  }

  .nav-link {
    font-size: 14px;
    font-weight: 300;
    line-height: 1;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--duration-base) ease;
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
  }

  /* The design hides the section links below 880px; a toggle takes over so the
     sections stay reachable on mobile. */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 34px;
    height: 34px;
    padding: 0 7px;
    border: 1px solid var(--border);
    border-radius: var(--radius-brand);
    background: transparent;
    cursor: pointer;
  }

  .nav-toggle-bar {
    display: block;
    width: 100%;
    height: 1.5px;
    border-radius: 2px;
    background: var(--text-primary);
    transition: transform var(--duration-base) var(--ease-out),
      opacity var(--duration-base) ease;
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  .nav-mobile {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 8px clamp(20px, 5vw, 48px) 18px;
    border-top: 1px solid color-mix(in srgb, var(--border) 55%, transparent);
  }

  .nav-mobile[hidden] {
    display: none;
  }

  .nav-mobile-link {
    padding: 12px 0;
    font-size: 15px;
    font-weight: 300;
    color: var(--text-secondary);
    text-decoration: none;
  }

  .nav-mobile-link:hover {
    color: var(--text-primary);
  }

  .lang-switch--mobile {
    align-self: flex-start;
    margin-top: 10px;
  }

  @media (max-width: 880px) {
    .nav-links {
      display: none;
    }

    .nav-toggle {
      display: flex;
    }
  }

  /* Below ~440px the wordmark, the language pill, the CTA and the toggle no
     longer fit on one line, so the language pill moves into the menu. */
  @media (max-width: 440px) {
    .nav-inner {
      padding-inline: 16px;
      gap: 12px;
    }

    .nav-logo {
      height: 18px;
    }

    .nav-right > .lang-switch {
      display: none;
    }

    .nav-right {
      gap: 10px;
    }
  }

  /* Very narrow screens: only the wordmark and the toggle stay in the bar; the
     CTA joins the language pill inside the menu. */
  @media (max-width: 360px) {
    .nav-cta {
      display: none;
    }

    .nav-inner {
      padding-inline: 14px;
    }
  }

  .nav-mobile-cta {
    align-self: flex-start;
    margin-top: 12px;
  }

  @media (min-width: 441px) {
    .lang-switch--mobile {
      display: none;
    }
  }

  @media (min-width: 361px) {
    .nav-mobile-cta {
      display: none;
    }
  }

  @media (min-width: 881px) {
    .nav-mobile {
      display: none;
    }
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 7px 9px;
    border: 1px solid var(--border);
    border-radius: var(--radius-brand);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    text-decoration: none;
    transition: border-color var(--duration-base) ease;
  }

  .lang-switch:hover {
    border-color: var(--text-secondary);
  }

  .lang-active {
    color: var(--tag-green);
  }

  .lang-idle {
    color: var(--text-secondary);
  }

  .lang-sep {
    color: var(--text-secondary);
    opacity: 0.5;
  }

  .navbar-scrolled {
    background-color: color-mix(in srgb, var(--background) 88%, transparent);
    border-bottom-color: color-mix(in srgb, var(--border) 75%, transparent);
  }

  :global([data-theme="light"]) #navbar {
    background-color: color-mix(in srgb, var(--background) 76%, transparent);
    border-bottom-color: color-mix(in srgb, var(--border) 22%, transparent);
  }

  :global([data-theme="light"]) .navbar-scrolled {
    background-color: color-mix(in srgb, var(--background) 92%, transparent);
  }

  :global([data-theme="light"]) .nav-logo {
    filter: brightness(0);
  }
</style>
