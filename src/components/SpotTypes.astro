---
/**
 * Spot types showcase — flowing inline layout, no cards, no links.
 * Icons and labels displayed in a clean, organic horizontal flow
 * with subtle separators.
 */
import type { Locale } from "../i18n/translations";
import { t } from "../i18n/translations";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);

const spotTypes = [
  { icon: "/icons/spots/surf.svg", name: strings.spot_surf },
  { icon: "/icons/spots/beach.svg", name: strings.spot_beach },
  { icon: "/icons/spots/summit.svg", name: strings.spot_summit },
  { icon: "/icons/spots/viewpoint.svg", name: strings.spot_viewpoint },
  { icon: "/icons/spots/cliff_jumping.svg", name: strings.spot_cliff_jumping },
  { icon: "/icons/spots/waterfall.svg", name: strings.spot_waterfalls },
  { icon: "/icons/spots/lake.svg", name: strings.spot_lake },
  { icon: "/icons/spots/natural_pools.svg", name: strings.spot_natural_pools },
  { icon: "/icons/spots/caves.svg", name: strings.spot_caves },
  { icon: "/icons/spots/diving.svg", name: strings.spot_diving },
  { icon: "/icons/spots/adventure.svg", name: strings.spot_adventure },
];
---

<section id="spot-types" class="page-section" aria-labelledby="spot-types-title">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="section-intro section-intro--center">
      <p class="section-kicker">{strings.spot_types_label}</p>
      <h2 id="spot-types-title" class="section-title max-w-[14ch]">
        {strings.spot_types_title}
      </h2>
      <p class="section-copy max-w-2xl">
        {strings.spot_types_subtitle}
      </p>
    </div>

    <ul class="mx-auto mt-14 flex max-w-5xl flex-wrap items-center justify-center gap-x-6 gap-y-4 sm:gap-x-8" role="list">
      {spotTypes.map((spot) => (
        <li>
          <div class="spot-type-item inline-flex items-center gap-2.5">
            <img
              src={spot.icon}
              alt=""
              class="spot-icon h-5 w-5 sm:h-6 sm:w-6"
              loading="lazy"
              aria-hidden="true"
            />
            <span
              class="text-sm font-semibold sm:text-base"
              style="color: var(--text-primary);"
            >
              {spot.name}
            </span>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .spot-type-item {
    transition: opacity 0.2s ease;
  }

  .spot-type-item:hover {
    opacity: 0.72;
  }
</style>
