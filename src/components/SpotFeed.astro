---
/**
 * "El feed" — a 4x2 rectangle of real, verified spots pulled from Firebase at
 * build time, picked for country and spot-type variety. Each card links out to
 * the spot on the web app.
 */
import type { Locale } from "../i18n/translations";
import { t } from "../i18n/translations";
import { inlineJson } from "../lib/inline-json";
import { fetchLandingSpots } from "../lib/spots";
import SpotCard from "./SpotCard.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);
const landing = await fetchLandingSpots(locale);
const feedSpots = landing.grid;
const gridPool = landing.rotation.grid;
---

{feedSpots.length > 0 && (
  <section id="feed" class="page-section" aria-labelledby="feed-title">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="feed-header">
        <div class="section-intro section-intro--left">
          <p class="section-kicker">{strings.feed_label}</p>
          <h2 id="feed-title" class="section-title max-w-[18ch]">{strings.feed_title}</h2>
        </div>
        <p class="feed-support-copy">{strings.feed_subtitle}</p>
      </div>

      {/* Server-rendered cards, swapped in place by the rotation script. The
          section is far below the fold, so the lazy covers have not been
          requested yet and the swap is invisible. */}
      <div class="feed-grid" data-feed-grid>
        {feedSpots.map((spot) => (
          <SpotCard spot={spot} locale={locale} />
        ))}
      </div>
    </div>

    <script type="application/json" data-feed-rotation set:html={inlineJson(gridPool)}></script>
  </section>
)}

<script>
  import { fadeInImage } from "../scripts/fade-in-image";

  interface RotationOption {
    id: string;
    name: string;
    country: string;
    typeCode: string;
    typeLabel: string;
    cover: string;
  }

  function shuffle<T>(items: T[]): T[] {
    const copy = items.slice();
    for (let i = copy.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      const swap = copy[i]!;
      copy[i] = copy[j]!;
      copy[j] = swap;
    }
    return copy;
  }

  /**
   * Mirrors the build-time selection: prefer an unseen country *and* an unseen
   * spot type, then relax to either, then take whatever is left. Drawing eight
   * at random from the pool would regularly land four beaches from one country.
   */
  function pickVaried(pool: RotationOption[], limit: number): RotationOption[] {
    const ranked = shuffle(pool);
    const picked: RotationOption[] = [];
    const countries = new Set<string>();
    const types = new Set<string>();

    const passes: Array<(option: RotationOption) => boolean> = [
      (option) => !countries.has(option.country) && !types.has(option.typeCode),
      (option) => !countries.has(option.country) || !types.has(option.typeCode),
      () => true,
    ];

    for (const accepts of passes) {
      for (const option of ranked) {
        if (picked.length >= limit) {
          return picked;
        }
        if (picked.includes(option) || !accepts(option)) {
          continue;
        }

        picked.push(option);
        countries.add(option.country);
        types.add(option.typeCode);
      }
    }

    return picked;
  }

  const rotationNode = document.querySelector<HTMLScriptElement>("[data-feed-rotation]");
  const pool = rotationNode?.textContent ? JSON.parse(rotationNode.textContent) as RotationOption[] : [];
  const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-spot-card]"));

  if (cards.length > 0 && pool.length > 0) {
    const picks = pickVaried(pool, cards.length);

    cards.forEach((card, index) => {
      const picked = picks[index];
      if (!picked) {
        return;
      }

      card.href = `https://web.outzero.app/spot/${picked.id}`;
      card.setAttribute("data-spot-id", picked.id);
      card.setAttribute("aria-label", `${picked.name}, ${picked.country}`);

      const cover = card.querySelector<HTMLImageElement>("[data-spot-card-cover]");
      if (cover) {
        fadeInImage(cover);
        cover.setAttribute("src", picked.cover);
      }

      card.querySelector<HTMLElement>("[data-spot-card-country]")?.replaceChildren(picked.country);
      card.querySelector<HTMLElement>("[data-spot-card-title]")?.replaceChildren(picked.name);
      card.querySelector<HTMLElement>("[data-spot-card-type]")?.replaceChildren(picked.typeLabel);
    });
  }
</script>

<style>
  .feed-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 44px;
  }

  .feed-support-copy {
    max-width: 340px;
    margin: 0;
    font-size: 15px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* Fixed column counts keep the 8 cards a clean rectangle (4x2 on desktop,
     2x4 on tablet) instead of the ragged 5+3 an auto-fill grid produces. */
  .feed-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  /* Two per row all the way down: one card per row turned the section into an
     endless column on a phone. */
  @media (max-width: 1024px) {
    .feed-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .feed-grid {
      gap: 10px;
    }
  }
</style>
