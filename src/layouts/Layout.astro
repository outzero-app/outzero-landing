---
import "../styles/global.css";
import type { Locale } from "../i18n/translations";
import { localeHomePath, t } from "../i18n/translations";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
}

const { locale, title, description } = Astro.props;
const strings = t(locale);
const pageTitle = title ?? strings.meta_title;
const pageDesc = description ?? strings.meta_description;
const langAttr = locale === "es" ? "es" : "en";
const siteOrigin = Astro.url.origin;
const siteUrl = siteOrigin;
const pageUrl = new URL(localeHomePath(locale), siteOrigin).toString();
const englishUrl = new URL("/", siteOrigin).toString();
const spanishUrl = new URL("/es/", siteOrigin).toString();
const faviconIcoUrl = new URL("/favicon.ico", siteOrigin).toString();
const favicon16Url = new URL("/favicon-16.png", siteOrigin).toString();
const favicon32Url = new URL("/favicon-32.png", siteOrigin).toString();
const favicon48Url = new URL("/favicon-48.png", siteOrigin).toString();
const favicon96Url = new URL("/favicon-96.png", siteOrigin).toString();
const favicon192Url = new URL("/favicon-192.png", siteOrigin).toString();
const organizationLogoUrl = new URL("/icon-512.png", siteOrigin).toString();
const appleTouchIconUrl = new URL("/apple-touch-icon.png", siteOrigin).toString();
const manifestUrl = new URL("/site.webmanifest", siteOrigin).toString();
const ogImageUrl = new URL("/og-image.png", siteOrigin).toString();
const ogLocale = locale === "es" ? "es_ES" : "en_US";
const ogAlternateLocale = locale === "es" ? "en_US" : "es_ES";
const shouldAutoRedirect = locale === "en";
const structuredData = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    name: "Outzero",
    url: siteUrl,
    logo: {
      "@type": "ImageObject",
      url: organizationLogoUrl,
      width: 512,
      height: 512,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    url: siteUrl,
    name: "Outzero",
    inLanguage: ["en", "es"],
    publisher: {
      "@id": `${siteUrl}/#organization`,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: pageTitle,
    description: pageDesc,
    inLanguage: langAttr,
    isPartOf: {
      "@id": `${siteUrl}/#website`,
    },
  },
]);
---

<!doctype html>
<html lang={langAttr} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={pageUrl} />
    <!-- Favicon: search engines require a square icon whose size is a multiple of 48px -->
    <link rel="icon" href={faviconIcoUrl} sizes="any" />
    <link rel="icon" type="image/png" href={favicon16Url} sizes="16x16" />
    <link rel="icon" type="image/png" href={favicon32Url} sizes="32x32" />
    <link rel="icon" type="image/png" href={favicon48Url} sizes="48x48" />
    <link rel="icon" type="image/png" href={favicon96Url} sizes="96x96" />
    <link rel="icon" type="image/png" href={favicon192Url} sizes="192x192" />
    <link rel="shortcut icon" href={faviconIcoUrl} />
    <link rel="apple-touch-icon" href={appleTouchIconUrl} sizes="180x180" />
    <link rel="manifest" href={manifestUrl} />
    <script is:inline define:vars={{ shouldAutoRedirect }}>
      // Runs on every page, before anything renders.
      //
      // An explicit `?lang=` always wins and is persisted immediately: the
      // language switcher carries the choice in the URL rather than relying on
      // a click handler, so picking a language can never be undone by the
      // auto-redirect below racing a not-yet-hydrated listener.
      const STORAGE_KEY = "outzero-locale";

      const saveLocale = (value) => {
        try {
          window.localStorage.setItem(STORAGE_KEY, value);
        } catch {
          /* private mode — fall through, the URL still decided the language */
        }
      };

      const requestedLocale = new URLSearchParams(window.location.search).get("lang");

      if (requestedLocale === "en" || requestedLocale === "es") {
        saveLocale(requestedLocale);
        const cleanUrl = window.location.pathname + window.location.hash;
        window.history.replaceState(null, "", cleanUrl);
      } else if (shouldAutoRedirect) {
        const currentPath = window.location.pathname;
        if (currentPath === "/" || currentPath === "/index.html") {
          let savedLocale = null;
          try {
            savedLocale = window.localStorage.getItem(STORAGE_KEY);
          } catch {
            savedLocale = null;
          }

          if (savedLocale === "es") {
            window.location.replace("/es/");
          } else if (savedLocale !== "en") {
            const browserLanguages =
              Array.isArray(navigator.languages) && navigator.languages.length > 0
                ? navigator.languages
                : [navigator.language];
            const prefersSpanish = browserLanguages.some(
              (language) => typeof language === "string" && /(^es\b)|(-ES\b)/i.test(language),
            );

            saveLocale(prefersSpanish ? "es" : "en");
            if (prefersSpanish) {
              window.location.replace("/es/");
            }
          }
        }
      }
    </script>

    <!-- SEO -->
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta http-equiv="content-language" content={langAttr} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="application-name" content="Outzero" />
    <meta name="apple-mobile-web-app-title" content="Outzero" />
    <meta name="theme-color" content="#000000" />

    <!-- Alternate languages -->
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="es" href={spanishUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Outzero" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogAlternateLocale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={pageTitle} />

    <script type="application/ld+json" set:html={structuredData}></script>

    <!--
      Every spot photo on the page — the hero above all, which is the LCP
      element — lives on Firebase Storage. Without this the browser cannot even
      begin the DNS lookup, TCP handshake and TLS negotiation for that host
      until it has parsed far enough to find a URL pointing at it.
    -->
    <link rel="preconnect" href="https://firebasestorage.googleapis.com" crossorigin />
    <link rel="dns-prefetch" href="https://firebasestorage.googleapis.com" />

    <!--
      Preload critical fonts — the latin partition, all three weights.
      The hero's paragraph is what LCP ends up measuring: it paints in the
      fallback face and repaints once Poppins lands, and that repaint registers
      a new LCP candidate. All three weights are above the fold, and the one
      that used to be left out was discovered by the parser a second late and
      then held the repaint back. At 8KB each that is a cheap thing to
      guarantee; it was not when they were 50KB.
    -->
    <link rel="preload" href="/fonts/Poppins-Light-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Poppins-SemiBold-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Poppins-Bold-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="min-h-screen overflow-x-hidden">
    <a href="#main-content" class="skip-link">{strings.skip_to_content}</a>
    <slot />
  </body>
</html>
